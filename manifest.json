{
  "manifest_version": 3,
  "name": "TEDUH APDL Fast Access",
  "version": "2.0.1",
  "description": "Quick access to TEDUH project details and unit status tracking by APDL code.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://teduh.kpkt.gov.my/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TEDUH APDL Fast Access",
    "default_icon": {
      "16": "house-icon.png",
      "48": "house-icon.png",
      "128": "house-icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_legacy_redirect",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}